# Copy this file to .env and adjust as needed.
# Vite only exposes vars that start with VITE_ to the client.

# --- Backend API ------------------------------------------------------------
# RESTCareFul Django backend (JWT). This is the single data source now — the
# old npoint.io mock has been removed and the whole app talks to this API via
# src/api/http.js. Repo: https://github.com/DevAbdoTolba/RESTCareFul
VITE_BACKEND_URL=http://localhost:8000/api/v1

# --- PayPal (sandbox) -------------------------------------------------------
# Checkout uses the SERVER-SIDE approval-URL redirect: the backend creates the
# order and captures it (secret lives in the backend .env). This client id is
# therefore optional here — kept for reference / future client-side buttons.
# Get one at https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=
